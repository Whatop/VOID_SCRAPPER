  - textKey: dialogue.rescue_contact.service.choice.decline
    korean: "\uC9C0\uAE08\uC740 \uD544\uC694 \uC5C6\uB2E4."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
