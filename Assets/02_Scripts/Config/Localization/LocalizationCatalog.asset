  - textKey: dialogue.tutorial.unknown_access_key.line_02
    korean: "\uC7A0\uAE50, \uC811\uC18D \uD328\uD134\uC774 \uAE30\uCCB4 \uCABD\uC73C\uB85C\u2014"
