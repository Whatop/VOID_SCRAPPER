    maxLengthHint: 24
  - textKey: dialogue.rescue_contact.service.line_01
    korean: "\uAD6C\uC870 \uC2E0\uD638\uB97C \uB530\uB77C\uC628 \uAC74\uAC00? \uC0B4\uC558\uB2E4\uB294
      \uAC8C \uC544\uC9C1 \uC2E4\uAC10\uC774 \uC548 \uB098\uB294\uAD70."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: RescueContact service opening line
    notes: Approved Korean source
    maxLengthHint: 72
  - textKey: dialogue.rescue_contact.service.line_02
    korean: "\uC228\uC5B4 \uC788\uB294 \uB3D9\uC548 \uC774 \uD574\uC5ED\uC758 \uCF54\uC5B4
      \uCD94\uC801 \uC2E0\uD638\uB97C \uBAA8\uC544\uB480\uC5B4. \uBC1B\uC544\uAC00\uBA74
      \uBAA9\uD45C \uC704\uCE58\uB97C \uB354 \uBE68\uB9AC \uC881\uD790 \uC218 \uC788\uC744
      \uAC70\uC57C."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: RescueContact service offer line
    notes: Approved Korean source
    maxLengthHint: 112
  - textKey: dialogue.rescue_contact.service.unavailable
    korean: "\uC774\uBBF8 \uACF5\uC720\uBC1B\uC558\uAC70\uB098 \uD604\uC7AC\uB294
      \uC2E0\uD638\uB97C \uBC1B\uC744 \uC218 \uC5C6\uB2E4."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: RescueContact unavailable response
    notes: Used instead of a disabled-choice reason in Phase 2B
    maxLengthHint: 56
  - textKey: dialogue.story.first_settlement_unknown_core.line_01
    korean: "\uADC0\uD658 \uC2E0\uD638\uC5D0\uC11C \uBE44\uC815\uC0C1 \uD30C\uD615\uC774
      \uAC80\uCD9C\uB410\uB2E4. \uD68C\uC218\uD55C \uBB3C\uCCB4\uC640 \uAE30\uCCB4
      \uAE30\uB85D\uC744 \uACA9\uB9AC \uBD84\uC11D \uC911\uC774\uB2E4."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: First Settlement unknown-core analysis line 1
    notes: Approved Phase 2C Korean source
    maxLengthHint: 96
  - textKey: dialogue.story.first_settlement_unknown_core.line_02
    korean: "\uB124 \uAE30\uCCB4\uC5D0 \uBD99\uC740 \uAC74 \uB2E8\uC21C\uD55C \uC624\uC5FC\uC774
      \uC544\uB2C8\uC57C. \uBD95\uAD34 \uC804 \uBB3C\uB958\uB9DD\uC5D0 \uC811\uC18D\uD558\uB358
      \uD0A4 \uAD6C\uC870\uC640 \uB2EE\uC558\uC5B4."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: First Settlement unknown-core analysis line 2
    notes: Approved Phase 2C Korean source
    maxLengthHint: 104
  - textKey: dialogue.story.first_settlement_unknown_core.line_03
    korean: "\uBB38\uC81C\uB294 \uC190\uC0C1\uB410\uB2E4\uB294 \uAC70\uC57C. \uADF8\uB300\uB85C
      \uB450\uBA74 \uC5B4\uB514\uC5D0 \uC5F0\uACB0\uB418\uB294\uC9C0\uC870\uCC28
      \uC54C \uC218 \uC5C6\uC5B4."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: First Settlement unknown-core analysis line 3
    notes: Approved Phase 2C Korean source
    maxLengthHint: 88
  - textKey: dialogue.story.first_settlement_unknown_core.line_04
    korean: "\uC815\uCC29\uC9C0 \uB2E8\uB9D0\uC5D0\uC11C \uC784\uC2DC \uACBD\uB85C
      \uC138 \uAC1C\uB97C \uBCF5\uC6D0\uD588\uC5B4. \uAC01 \uD574\uC5ED\uC758 \uAD00\uB9AC
      \uC7A5\uCE58\uC5D0 \uC548\uC815\uD654 \uBD80\uD488\uC774 \uB0A8\uC544 \uC788\uC744
      \uAC00\uB2A5\uC131\uC774 \uB192\uC544."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: First Settlement quest route line 4
    notes: Approved Phase 2C Korean source
    maxLengthHint: 120
  - textKey: dialogue.story.first_settlement_unknown_core.line_05
    korean: "\uAD6C\uD68D \uC548\uC815\uAE30, \uBB3C\uC9C8 \uC555\uCD95\uB85C, \uC704\uC0C1
      \uD56D\uBC95 \uB80C\uC988. \uC138 \uBD80\uD488\uC744 \uD655\uBCF4\uD558\uBA74
      \uC811\uC18D\uD0A4\uB97C \uC644\uC131\uD560 \uC218 \uC788\uC5B4."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: First Settlement quest parts line 5
    notes: Approved Phase 2C Korean source
    maxLengthHint: 104
  - textKey: dialogue.story.first_settlement_unknown_core.line_06
    korean: "\uD0D0\uC0AC \uACBD\uB85C\uB97C \uB4F1\uB85D\uD560\uAC8C. \uC900\uBE44\uAC00
      \uB05D\uB098\uBA74 \uCD9C\uBC1C\uD574."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: First Settlement quest start line 6
    notes: Approved Phase 2C Korean source
    maxLengthHint: 64
  - textKey: dialogue.story.first_settlement_unknown_core.line_07
    korean: "\uBD80\uD488\uC744 \uD68C\uC218\uD560 \uB54C\uB9C8\uB2E4 \uAE30\uCCB4\uC758
      \uC774\uC0C1 \uD30C\uD615\uB3C4 \uCEE4\uC9C8 \uC218 \uC788\uC5B4. \uBC18\uC751\uC740
      \uACC4\uC18D \uCD94\uC801\uD560\uAC8C."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: First Settlement part-response warning before departure
    notes: Read-only Pixel Curse reaction; Settlement Control
    maxLengthHint: 96
  - textKey: dialogue.story.first_settlement_unknown_core.line_08
    korean: "\uC138 \uBD80\uD488\uC744 \uBAA8\uC544\uB3C4 \uC790\uB3D9 \uBCF5\uC6D0\uB418\uC9C4
      \uC54A\uC544. \uC815\uCC29\uC9C0 \uD68C\uC218 \uCC98\uB9AC\uC7A5\uC5D0\uC11C
      \uACA9\uB9AC \uBCF5\uC6D0\uC744 \uC9C4\uD589\uD574."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: First Settlement explicit Recovery Processor instruction before departure
    notes: No automatic restoration; Operator
    maxLengthHint: 96
  - textKey: dialogue.story.main_damaged_access_key.active_0
    korean: "\uACBD\uB85C\uB294 \uC138 \uACF3 \uBAA8\uB450 \uC0B4\uC544 \uC788\uC5B4.
      \uAC00\uAE4C\uC6B4 \uC2E0\uD638\uBD80\uD130 \uD655\uC778\uD574."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Damaged access-key repeat dialogue at zero parts
    notes: Read-only authoritative quest state
    maxLengthHint: 64
  - textKey: dialogue.story.main_damaged_access_key.active_0.line_02
    korean: "\uC0C8 \uBD80\uD488\uC740 \uC544\uC9C1 \uC5C6\uC5B4. \uAE30\uCCB4\uC758
      \uC774\uC0C1 \uD30C\uD615\uC740 \uACC4\uC18D \uAC10\uC2DC \uC911\uC774\uC57C."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Damaged access-key zero-part monitoring response
    notes: Read-only Active0 and existing Curse level 1; Settlement Control
    maxLengthHint: 72
  - textKey: dialogue.story.main_damaged_access_key.active_1
    korean: "\uCCAB \uBD80\uD488\uC740 \uC548\uC815\uC801\uC774\uC57C. \uB450 \uAC1C
      \uB0A8\uC558\uC5B4."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Damaged access-key repeat dialogue at one part
    notes: Read-only authoritative quest state
    maxLengthHint: 48
  - textKey: dialogue.story.main_damaged_access_key.active_1.line_02
    korean: "\uC811\uC18D\uD0A4\uAC00 \uCCAB \uBD80\uD488\uC5D0 \uBC18\uC751\uD588\uC5B4.
      \uAE30\uCCB4\uC758 \uBCF4\uB77C\uC0C9 \uC774\uC0C1 \uD30C\uD615\uB3C4 \uD55C
      \uB2E8\uACC4 \uAC15\uD574\uC84C\uC5B4."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Damaged access-key one-part response
    notes: Read-only Active1 and derived Curse level 2; Settlement Control
    maxLengthHint: 88
  - textKey: dialogue.story.main_damaged_access_key.active_2
    korean: "\uBB3C\uC9C8 \uC555\uCD95\uB85C\uAE4C\uC9C0 \uD68C\uC218\uD588\uC5B4.
      \uB450 \uBC88\uC9F8 \uBD80\uD488 \uD655\uC778 \uC644\uB8CC. \uC774\uC81C \uB9C8\uC9C0\uB9C9
      \uBD80\uD488\uB9CC \uB0A8\uC558\uC5B4."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Damaged access-key repeat dialogue at two parts
    notes: Read-only authoritative quest state
    maxLengthHint: 88
  - textKey: dialogue.story.main_damaged_access_key.active_2.line_02
    korean: "\uC774\uC0C1 \uD30C\uD615\uB3C4 \uB354 \uAC15\uD574\uC84C\uC5B4. \uBD84\uC11D\uC744
      \uB9C8\uCE58\uBA74 3\uD574\uC5ED \uD56D\uB85C\uB97C \uC2B9\uC778\uD560\uAC8C.
      \uB9C8\uC9C0\uB9C9 \uD68C\uC218\uC5D0 \uB300\uBE44\uD574."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Damaged access-key two-part response
    notes: Read-only Active2; existing natural-completion action authorizes the route;
      Settlement Control
    maxLengthHint: 96
  - textKey: dialogue.story.main_damaged_access_key.completed
    korean: "\uC811\uC18D\uD0A4\uAC00 \uC548\uC815\uD654\uB410\uC5B4. \uC774\uC81C
      \uC911\uC559 \uB124\uD2B8\uC6CC\uD06C\uB85C \uC774\uC5B4\uC9C4 \uACBD\uB85C\uB97C
      \uCD94\uC801\uD560 \uC218 \uC788\uC5B4."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Damaged access-key repeat dialogue after completion
    notes: Read-only RouteCore state
    maxLengthHint: 88
  - textKey: dialogue.story.main_damaged_access_key.completed.line_02
    korean: "\uC811\uC18D\uD0A4\uB294 \uBCF5\uC6D0\uB410\uC9C0\uB9CC \uBCF4\uB77C\uC0C9
      \uC774\uC0C1 \uD30C\uD615\uC740 \uB0A8\uC544 \uC788\uC5B4. \uCD94\uC801\uC740
      \uACC4\uC18D\uD560\uAC8C."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Damaged access-key restored follow-up
    notes: Read-only Completed; Pixel Curse remains persistent; Settlement Control
    maxLengthHint: 80
  - textKey: dialogue.story.main_damaged_access_key.ready_to_restore
    korean: "\uC138 \uBD80\uD488 \uD655\uC778 \uC644\uB8CC. \uC811\uC18D\uD0A4 \uBC18\uC751\uACFC
      \uBCF4\uB77C\uC0C9 \uC774\uC0C1 \uD30C\uD615 \uBAA8\uB450 \uCD5C\uACE0\uCE58\uC57C."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Damaged access-key repeat dialogue when all parts are ready
    notes: Read-only authoritative quest state; Settlement Control
    maxLengthHint: 80
  - textKey: dialogue.story.main_damaged_access_key.ready_to_restore.line_02
    korean: "\uC138 \uBD80\uD488\uC740 \uBAA8\uB450 \uD655\uBCF4\uD588\uC9C0\uB9CC
      \uD604\uC7A5 \uC870\uB9BD\uC740 \uC704\uD5D8\uD574. \uD68C\uC218 \uCC98\uB9AC\uC7A5\uC5D0\uC11C
      \uC9C1\uC811 \uACA9\uB9AC \uBCF5\uC6D0\uC744 \uC9C4\uD589\uD574."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Damaged access-key explicit restoration direction
    notes: Read-only ReadyToRestore and derived Curse level 4; Operator
    maxLengthHint: 96
  - textKey: dialogue.tutorial.fake_operator_takeover.line_01
    korean: "\uACBD\uB85C\uB97C \uD655\uC778\uD588\uC5B4. \uB808\uC774\uB354\uC758
      \uBBF8\uD655\uC778 \uC2E0\uD638\uB97C \uB530\uB77C\uAC00."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Tutorial corrupted Operator takeover
    notes: FakeOperator uses the Operator display name while retaining a stable hidden
      actor identity
    maxLengthHint: 64
  - textKey: dialogue.tutorial.operator_ancient_signal.line_01
    korean: "\uACE0\uAC00\uCE58 \uC794\uD574 \uC2E0\uD638\uC57C. \uBC29\uC5B4 \uAE30\uCCB4\uAC00
      \uC788\uC744 \uC218 \uC788\uC73C\uB2C8 \uC870\uC2EC\uD574."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Tutorial ancient-signal guidance
    notes: Shown only after the ancient wreck signal is detected
    maxLengthHint: 64
  - textKey: dialogue.tutorial.operator_opening.line_01
    korean: "\uB4E4\uB9AC\uBA74 \uCD94\uC9C4\uAE30\uB97C \uC6C0\uC9C1\uC5EC \uBD10.
      \uC5EC\uAE30\uC11C\uB294 \uC9C1\uC811 \uAE38\uC744 \uCC3E\uC544\uC57C \uD574."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Tutorial movement guidance
    notes: Shown when the movement objective becomes active
    maxLengthHint: 64
  - textKey: dialogue.tutorial.operator_radar.line_01
    korean: "[var=VS_RadarToggleBinding]\uB85C \uB808\uC774\uB354\uB97C \uCF20 \uB4A4,
      [var=VS_RadarScanBinding]\uB85C \uC2A4\uCE94\uD574."
    english: 
    japanese: 
    simplifiedChinese: 
    traditionalChinese: 
    context: Tutorial Radar guidance
    notes: Input binding variables are populated immediately before conversation
