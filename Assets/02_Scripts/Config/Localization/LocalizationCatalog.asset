    notes: Uses existing restoration confirmation button
    maxLengthHint: 24
  - textKey: quest.main_damaged_access_key.restoration.completed
    korean: 접속키 복구 완료
    english:
    japanese:
    simplifiedChinese:
    traditionalChinese:
