    },
    "m_Slots": [
        {
            "m_Id": "798e01ad9bba4941accf8b9312b3916a"
        },
        {
            "m_Id": "80b1eb805a5d47faa1ddea948a0cc83c"
        },
        {
            "m_Id": "4583731f05144e8db94ffc78177301ab"
        },
        {
            "m_Id": "578c6d4bddd9443ea0e3380aec2f404d"
        },
        {
            "m_Id": "a6f51fd874454fb0a2006369d56acf89"
        },
        {
            "m_Id": "68bbcfc7b32143288c60cde79b1bc911"
        },
        {
            "m_Id": "5202056b576f47dda8adb3db0edc32d6"
        },
        {
            "m_Id": "5ac0c008eb074d52bf860dd228b69a32"
        },
        {
            "m_Id": "f50282f1d7eb4923b89d8494f71bc655"
        },
        {
            "m_Id": "055ad1cba3f347b3a533378543765dca"
        },
        {
            "m_Id": "d87ee3c27d8a44388fc2f2bc6b525afc"
        },
        {
            "m_Id": "8b899dfda05649428db9da7618c82015"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RouteCoreSignal",
    "m_FunctionSource": "",
    "m_FunctionBody": "// Stable blocks: no UV displacement or texture blur. At most three noise changes/second.\nfloat2 cell = floor(UV.xy * max(4.0, NoiseScale));\nfloat tick = floor(_Time.y * max(0.0, NoiseSpeed));\nfloat seed = frac(sin(dot(cell, float2(12.9898,78.233)) + tick * 17.13) * 43758.5453);\nfloat reveal = saturate(Reveal);\nfloat fragments = step(lerp(0.93, -0.01, reveal), seed);\nfloat cut = step(0.90, frac(sin(cell.y * 9.13 + tick) * 1731.7));\nfloat pulse = floor((sin(_Time.y * 2.0) * 0.5 + 0.5) * 4.0) / 4.0;\nfloat energy = 1.0 + pulse * PulseStrength;\nColor = float4(lerp(Sprite.rgb * BaseColor.rgb, CorruptionColor.rgb, 0.65) * energy, 1.0);\nAlpha = Sprite.a * BaseColor.a * fragments * lerp(0.09, 0.38, reveal)\n    * (1.0 - cut * saturate(GlitchStrength) * saturate(CorruptionAmount));\n"
}

