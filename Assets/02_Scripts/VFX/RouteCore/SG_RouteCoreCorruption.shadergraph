        "m_Id": ""
    },
    "m_Name": "Pixel Signal",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -240,
            "y": 260,
            "width": 140.0,
